class Solution {
public:

    bool isValid(string s) 
    {
        if (s.size() < 2 || s.size() % 2 != 0)
            return false;

        string stack {};

        for (size_t i = 0; i < s.size(); i ++)
        {
            char part = s[i];

            if ((part == ')' && stack.size() >= 1 && stack[stack.size() - 1] == '(') ||
                (part == ']' && stack.size() >= 1 && stack[stack.size() - 1] == '[') ||
                (part == '}' && stack.size() >= 1 && stack[stack.size() - 1] == '{'))
            {
                if (stack.size() <= 0)
                    return false; 

                stack.pop_back();
            }
            else
            {
                stack.push_back(s[i]);
            }
        }
        if (stack.size() != 0)
            return false;

        return true;
    }
};

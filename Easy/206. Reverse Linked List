        ListNode* output = nullptr;

        if (head != nullptr)
        {
            output = new ListNode;
            output->val = head->val;
            head = head->next;
        }

        while (head != nullptr)
        {
            ListNode* temp = new ListNode;
            temp->val = head->val;
            temp->next = output;
            output = temp;
            temp = nullptr;
            head = head->next;
        }

        return output;
    }

class Solution {
public:
    int search(vector<int>& nums, int target) {
        int search_range = nums.size();
        int search_target = 0;
        size_t index = nums.size() / 2;

        while (search_range > 0)
        {
            search_target = nums[index];
            search_range -= search_range / 2 > 1 ? search_range / 2 : 1;

            if (search_target == target)
            {
                return index;
            }
            else if (search_target > target)
            {
                index -= search_range / 2 > 1 ? search_range / 2 : 1;
            }
            else if (search_target < target)
            {
                index += search_range / 2 > 1 ? search_range / 2 : 1;
            }
        }
        if (search_target != target)
        {
            return -1;
        }
        
        return index;
    }
};

/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* list = new ListNode();
        ListNode* ptr1 = l1;
        ListNode* ptr2 = l2;
        ListNode* ptr3 = list;

        int integer1 = 0;
        int integer2 = 0;
        int result = 0;
        
        while (true)
        {
            if (ptr1 != nullptr)
            {
                integer1 = ptr1->val;
                ptr1 = ptr1->next;
            }
            else
            {
                integer1 = 0;
            }

            if (ptr2 != nullptr)
            {
                integer2 = ptr2->val;
                ptr2 = ptr2->next;
            }
            else
            {
                integer2 = 0;
            }

            result += integer1 + integer2;

            ptr3->val = result % 10;
            result /= 10;

            if (ptr1 != nullptr || ptr2 != nullptr || result != 0)
            {
                ptr3->next = new ListNode();
                ptr3 = ptr3->next;
            }
            else
            {
                ptr3 = nullptr;

                break;
            }
        }

        return list;
    }
};

class Solution {
public:
    int lengthOfLongestSubstring(string s) {
        unordered_map<char, int> map;
        size_t result = 0;
        size_t left = 0;
        
        for (size_t right = 0; right < s.size(); right++)
        {
            while (map.find(s[right]) != map.end())
            {
                map[s[left]]--;

                if (map[s[left]] == 0)
                {
                    map.erase(s[left]);
                }
                left++;
            }
            map[s[right]]++;
            result = max(result, right - left + 1);
        }

        return result;
    }
};

class Solution {
public:
    long long countCommas(long long n) {
        long long result {0};
        long long addition {0};
        long long product {1000};
        long long factor {1};
        
        while (product <= n)
        {
            factor ++;

            if (n >= product * 1000)
            {
                addition = ((product * 1000) - product) * (factor - 1);
            }
            else
            {
                addition = (1 + (n - product)) * (factor - 1);
            }
            result += addition;
            product *= 1000;

        }


        return result;
    }
};

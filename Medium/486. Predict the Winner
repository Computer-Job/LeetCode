class Solution {
public:
    int dp(vector<int>& nums, int left, int right)
    {
        if (left == right)
            return nums[left];

        int score = max(
            nums[left] - dp(nums, left + 1, right),
            nums[right] - dp(nums, left, right - 1)
        );

        return score;
    }

    bool predictTheWinner(vector<int>& nums) {
        int score = dp(nums, 0, nums.size() - 1);

        if (score >= 0)
            return true;
        
        return false;
    }
};
